# API de leitura. No desenvolvimento, o Vite encaminha /api para o mock local.
VITE_API_URL=/api

# Fallback estático sintético para desenvolvimento offline.
# Nunca coloque a planilha interna em public/ nem no bundle de produção.
VITE_DATA_URL=/data.json

# Permite usar o fallback sintetico fora do modo dev (somente demonstracao).
# Em producao com a API real, deixe ausente/false: sem API o painel mostra erro.
VITE_ALLOW_MOCK_FALLBACK=false
