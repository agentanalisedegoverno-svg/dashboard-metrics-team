# API de leitura. No desenvolvimento, o Vite encaminha /api para o mock local.
VITE_API_URL=/api

# Fallback estático sintético para desenvolvimento offline.
# Nunca coloque a planilha interna em public/ nem no bundle de produção.
VITE_DATA_URL=/data.json

# Permite usar o fallback sintetico fora do modo dev (somente demonstracao).
# Em producao com a API real, deixe ausente/false: sem API o painel mostra erro.
VITE_ALLOW_MOCK_FALLBACK=false

# --- Servidor (Cloudflare Pages Functions e GitHub Actions): NUNCA use o prefixo VITE_ e nunca versione valores ---
# Formato: postgresql://<papel>:<senha>@radar-prevendas-pg.postgres.database.azure.com:5432/radar?sslmode=require
# Cloudflare Pages (segredos): DATABASE_URL (radar_leitor), DATABASE_URL_APP (radar_app), DATABASE_URL_WRITER (radar_escritor)
# GitHub Actions (segredos): DATABASE_URL_BACKUP, DATABASE_URL_EMAIL, DATABASE_URL_PLANNER, DATABASE_URL_MONITOR, DATABASE_URL_MIGRACAO
# O valor é só a URL (sem o nome da variável na frente). Ver docs/MIGRACAO-AZURE.md.
