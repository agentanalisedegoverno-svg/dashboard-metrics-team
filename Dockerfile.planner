# Imagem do ciclo Radar -> Planner (Render cron job). Ver planner-auto/render-job.sh e docs/INTEGRACAO-PLANNER.md.
FROM node:22-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY planner-auto/requirements.txt planner-auto/requirements.txt
RUN pip3 install --no-cache-dir --break-system-packages -r planner-auto/requirements.txt
COPY config config
COPY functions/_lib functions/_lib
COPY scripts/planner-eventos.mjs scripts/planner-eventos.mjs
COPY planner-auto planner-auto
CMD ["sh", "planner-auto/render-job.sh"]
